{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../.tsbuild/common",
    "tsBuildInfoFile": "../.tsbuild/common.tsbuildinfo",
    "paths": {
      "@/ds/*": ["./src/ds/*"],
      "@common/*": ["./src/*"],
      "@injected/*": ["./src/*"]
    }
  },
  "include": ["src", "src/**/*.json", "*.ts"]
}
