# JMAP configuration of the e2e tmail-backend.
# Rendered by e2e/scripts/start.sh into e2e/docker/.generated/jmap.properties:
#   @PUBLIC_URL@ / @WEBSOCKET_URL@  the browser facing origin (nginx proxy), so the JMAP
#                                   session advertises same-origin apiUrl/uploadUrl/...
#   @AUTH_STRATEGIES@               Basic (+ Ticket) by default, + OIDC with E2E_OIDC=1
# Read https://james.apache.org/server/config-jmap.html for further details

enabled=true

tls.keystoreURL=file://conf/keystore
tls.secret=james72laBalle

jwt.publickeypem.url=file://conf/jwt_publickey
jwt.privatekeypem.url=file://conf/jwt_privatekey

# Must stay false (e2e/README.md, "Known backend quirks"): the memory image enables the email
# query view but does not register PopulateEmailQueryViewListener in listeners.xml, so the
# view stays empty and every Email/query `inMailbox` (or with `after` / `before`) sorted by
# `receivedAt` descending returns no ids, in every mailbox. With false, Email/query is always
# answered by the search index.
view.email.query.enabled=false

calendarEvent.reply.mailTemplateLocation=file://eml-template/
calendarEvent.reply.supportedLanguages=en,fr,mn

authentication.strategy.rfc8621=@AUTH_STRATEGIES@
url.prefix=@PUBLIC_URL@
websocket.url.prefix=@WEBSOCKET_URL@

@OIDC_BLOCK@
