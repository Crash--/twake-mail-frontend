{
  "name": "@twake-mail/e2e",
  "private": true,
  "description": "End to end tests of the Twake Mail web app (Playwright). Standalone package, not part of the app workspaces.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "stack:start": "./scripts/start.sh",
    "stack:stop": "./scripts/stop.sh",
    "test": "playwright test",
    "test:infra": "playwright test tests/infra.spec.ts",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "perf": "playwright test -c playwright.perf.config.ts",
    "perf:seed": "node --no-warnings scripts/seed-perf.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0"
  }
}
