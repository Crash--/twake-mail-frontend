{
  "name": "@mail/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "common"
  ],
  "scripts": {
    "start": "npm run start -w @mail/private",
    "build": "npm run build -w @mail/private",
    "serve": "npx serve -s apps/private/dist -l 5000",
    "test": "jest",
    "lint": "eslint apps common scripts",
    "lint:fix": "eslint apps common scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "copy-from-common": "node scripts/copy-from-common.js",
    "import-flutter-arb": "node scripts/import-flutter-arb.mjs",
    "test:scripts": "node --test 'scripts/**/*.spec.mjs'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@sentry/cli": false,
    "unrs-resolver": false,
    "github:Crash--/jmap-client-ts#f1682f4207f845718ec78ea996f5ff8eb1717085": true
  }
}
