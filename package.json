{
  "name": "@mail/frontend",
  "version": "0.18.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/*",
    "common"
  ],
  "scripts": {
    "start": "npm run start -w @mail/private",
    "build": "npm run build -w @mail/private",
    "serve": "npx serve -s apps/private/dist -l 5000",
    "test": "jest",
    "lint": "rs lint --singleThreaded apps common scripts",
    "lint:fix": "rs lint --singleThreaded --fix apps common scripts",
    "format": "rs fmt",
    "format:check": "rs fmt --check",
    "typecheck": "tsc -b",
    "copy-from-common": "node scripts/copy-from-common.js",
    "import-flutter-arb": "node scripts/import-flutter-arb.mjs",
    "test:scripts": "node --test 'scripts/**/*.spec.mjs'"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ios_saf < 16",
      "not and_uc < 16"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rstack": "0.9.3",
    "typescript": "~7.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@sentry/cli": false,
    "@swc/core": false,
    "unrs-resolver": false
  }
}
